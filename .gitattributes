# Normalize everything to LF in the repository. The _wsl/*.sh scripts run under
# Ubuntu and break outright if they are checked out with CRLF endings.
* text=auto eol=lf

# Patches must survive byte-for-byte or `git apply` rejects them.
*.patch -text

# ngspice netlists and generated run output are read by Linux tooling.
*.cir text eol=lf
*.sh  text eol=lf
*.py  text eol=lf
