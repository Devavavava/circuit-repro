# ─── Upstream clones ──────────────────────────────────────────────────────
# These are unmodified public repositories, pinned by commit SHA in
# UPSTREAM.md. They are deliberately NOT vendored here — re-create them with
# scripts/fetch_upstream.sh. Local fixes live in patches/ instead.
AnalogGenie/repo/
AutoCkt/repo/
CktGNN/repo/
Krylov-ICML2023/repo/
LaMAGIC2/repo/
extensions/AnalogSAGE/
extensions/CircuitSense/
extensions/RoSE/
extensions/ZeroSim/
misc/AnalogGenie-Lite/
misc/AnalogToBi/
misc/ZOAF/

# ─── Large binaries ───────────────────────────────────────────────────────
# Over or near GitHub's 100 MB per-file limit, or re-downloadable.
# See "Files not tracked" in README.md for where each one comes from.
_wsl/*.wsl
LaMAGIC2/ckpt/
LaMAGIC2/data/

# ─── Claude Code worktrees ────────────────────────────────────────────────
# Session worktrees live here; they are checkouts of this same repo and must
# never be committed into it.
.claude/worktrees/

# ─── ngspice run artefacts ────────────────────────────────────────────────
# Rewritten on every run that touches a BSIM4 model, wherever ngspice is invoked.
bsim4v5.out

# ─── LNA experiment artefacts ─────────────────────────────────────────────
# Regenerable: sampled sequences and emitted netlists. The meta.json files are
# kept because they carry the timing and termination stats behind FINDINGS.md.
lna/out/*/seq*.txt
lna/out/*.pth
lna/out/templates_train.json
lna/out/winners_train.json
lna/work/

# Label store (plans2/01-DATA §2): L2/L1 tables + snapshots are precious and
# stay in git; the point-row table is a bulky, regenerable-ish byproduct.
lna/data/sim_points.jsonl

# ─── Python / OS noise ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
Thumbs.db
desktop.ini
